# Copy this file to .env and fill in your keys. .env is gitignored.
#
# Get a key at https://console.anthropic.com/settings/keys (starts with sk-ant-).
# This is read ONLY by the server-side proxies (api/chat.js, api/screen.js). It
# is never sent to the browser — do NOT rename it with a VITE_ prefix, or Vite
# will bundle it into the public JS.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-opus-5 for both the chat assistant and the
# founder screening. Set ANTHROPIC_SCREEN_MODEL to use a different model just
# for screening.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_SCREEN_MODEL=claude-opus-5
# ANTHROPIC_REPLY_MODEL=claude-opus-5

# Application intake → Notion. Create the two data sources with
# `npm run notion:setup -- --confirm`, then paste the printed IDs here.
NOTION_TOKEN=your-notion-integration-token
NOTION_INVESTORS_DATA_SOURCE_ID=
NOTION_FOUNDERS_DATA_SOURCE_ID=

# Best-effort team notification after a website application is saved to Notion.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Conditional founder follow-up emails. APPLICATION_EMAIL_FROM must use a
# Resend-verified sending domain. Founder replies go to FOUNDER_REPLY_EMAIL.
RESEND_API_KEY=
APPLICATION_EMAIL_FROM="Silkroad Angels <applications@your-domain.com>"

# Founder reply automation. Use a Resend receiving domain or a custom subdomain
# with inbound MX records. Copy the webhook signing secret from the Resend
# webhook configured for POST /api/resend-inbound and email.received events.
FOUNDER_REPLY_EMAIL="replies@inbound.your-domain.com"
FOUNDER_REPLY_SIGNING_SECRET=
RESEND_WEBHOOK_SECRET=

# One-time database setup only: a Notion page shared with the integration.
NOTION_PARENT_PAGE_ID=

# Optional. Only browser pitch-deck uploads use this; founder replies do not.
BLOB_READ_WRITE_TOKEN=
