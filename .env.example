# Copy this file to .env.local and fill in your key. .env.local is gitignored.
#
# Get a key at https://console.anthropic.com/settings/keys (starts with sk-ant-).
# This is read ONLY by the server-side proxies (api/chat.js, api/screen.js). It
# is never sent to the browser — do NOT rename it with a VITE_ prefix, or Vite
# will bundle it into the public JS.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-opus-5 for both the chat assistant and the
# founder screening. Set ANTHROPIC_SCREEN_MODEL to use a different model just
# for screening.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_SCREEN_MODEL=claude-opus-5

# Application intake → Notion. Create the two data sources with
# `npm run notion:setup -- --confirm`, then paste the printed IDs here.
NOTION_TOKEN=your-notion-integration-token
NOTION_INVESTORS_DATA_SOURCE_ID=
NOTION_FOUNDERS_DATA_SOURCE_ID=

# Best-effort team notification after a website application is saved to Notion.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# One-time database setup only: a Notion page shared with the integration.
NOTION_PARENT_PAGE_ID=

# Added automatically when a private Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
